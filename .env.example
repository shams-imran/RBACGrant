## ===========================================================================
## RBACGrant configuration — copy to .env, chmod 0600.
##
## How to read this file:
##   KEY=value      active setting
##   #KEY=value     optional setting, currently OFF — the value shown is a
##                  realistic EXAMPLE; remove the # and adjust to enable
##   ## text        explanation only, never a setting
##
## Any secret value may be a secret ref:
##   env:NAME | file:/abs/path | vault:<mount>/<path>#<field> | sops:/abs/path#<field>
## ===========================================================================


## ════ 1 · SERVER & WEB ═════════════════════════════════════════════════════

## Address and port the web UI + API listen on. Keep 127.0.0.1 unless TLS is set.
RBAC_UI_BIND_ADDR: 0.0.0.0
RBAC_UI_PORT=8080

## URL users open in the browser (cookies/redirects). Non-loopback http:// is refused.
RBAC_UI_PUBLIC_URL=http://127.0.0.1:8080

## Allowed Host headers, comma-separated (blocks DNS rebinding).
RBAC_UI_ALLOWED_HOSTS=localhost,127.0.0.1

## Serve TLS directly: PEM cert + key files.
#RBAC_UI_TLS_CERT_FILE=/etc/rbac-ui/tls.crt
#RBAC_UI_TLS_KEY_FILE=/etc/rbac-ui/tls.key

## Reverse-proxy IPs allowed to set X-Forwarded-* (audit-log client IPs).
#RBAC_UI_TRUSTED_PROXIES=10.0.0.5,10.0.0.6

RBAC_UI_ALLOW_INSECURE_HTTP=false

## true = whole app is view-only: no apply, delete or kubeconfig issuing.
RBAC_UI_READ_ONLY=false

RBAC_UI_LOG_LEVEL=info

## Append-only audit log (JSON lines): logins, applies, deletes, kubeconfigs.
#RBAC_UI_AUDIT_LOG_FILE=/var/log/rbacgrant/audit.log
RBAC_UI_AUDIT_LOG_MAX_SIZE=64MiB


## ════ 2 · BRANDING ═════════════════════════════════════════════════════════

## Name shown in the header and on the login page.
RBAC_UI_BRAND_NAME=RBACGrant
#RBAC_UI_BRAND_LOGO_FILE=./logo.png


## ════ 3 · AUTHENTICATION & SESSIONS ════════════════════════════════════════

## local = username/password login.
## none  = no login, loopback-only personal profile (needs CLUSTER_STORE=none).
RBAC_UI_AUTH_MODE=local
RBAC_UI_ADMIN_USERNAME=admin

## Admin password. Preferred: Argon2id hash from `rbac-ui hash-password`.
#RBAC_UI_ADMIN_PASSWORD_REF=vault:secret/k8s-rbac-builder/auth#admin_password_hash

# default password is changeme@123456!! # Change it.
RBAC_UI_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$4XY3vzbrCYScUEEbVdP6ng$oDRRiJwVbLzSibnKTjBNrwVtssw0KQG1gLu9ffbeJW4'
## Discouraged: plaintext (hashed in memory at startup, warning logged).
#RBAC_UI_ADMIN_PASSWORD=changeme@123456!!

## Extra users (secret ref to a users file) with per-user role + cluster scope.
#RBAC_UI_USERS_REF=file:/etc/rbac-ui/users.json

## Idle logout, absolute session max, and the re-auth window accepted by
## "step-up" prompts (prod applies/deletes, cluster saves).
RBAC_UI_SESSION_IDLE_TIMEOUT=15m
RBAC_UI_SESSION_MAX_AGE=8h
RBAC_UI_STEP_UP_WINDOW=5m

## Login brute-force lockout.
RBAC_UI_LOGIN_MAX_ATTEMPTS=5
RBAC_UI_LOGIN_LOCKOUT=15m

## Minimum length for new passwords (default 6 when not set).
#RBAC_UI_MIN_PASSWORD_LENGTH=6


## ════ 4 · CLUSTER STORE (where uploaded kubeconfigs live) ══════════════════

## vault = HashiCorp Vault KV | local = encrypted file store | none = offline.
RBAC_UI_CLUSTER_STORE=local

## local store only: data directory + AES-GCM key (32-byte base64).
## Keep the key OUTSIDE the data dir and back it up — lost key = re-upload all.
#RBAC_UI_DATA_DIR=~/.local/share/k8s-rbac-builder
#RBAC_UI_STORE_KEY_REF=file:/etc/rbac-ui/store.key

## …or keep the key in HashiCorp Vault (connection in section 5). Put it with:
##   vault kv put secret/k8s-rbac-builder/store key=@/path/to/store.key
#RBAC_UI_STORE_KEY_REF=vault:secret/k8s-rbac-builder/store#key

## Pre-registered clusters from config (name=secret-ref), read-only in the UI.
#RBAC_UI_CLUSTERS=prod-dhaka=vault:secret/k8s/prod-dhaka#kubeconfig

## Scratch dir for transient client cert/key files; wiped on shutdown.
#RBAC_UI_RUNTIME_DIR=/dev/shm/rbacgrant

## Cache lifetimes for decrypted credentials / resolved secret refs.
RBAC_UI_CLUSTER_CRED_CACHE_TTL=5m
RBAC_UI_SECRET_CACHE_TTL=60s


## ════ 5 · VAULT CONNECTION (only if vault: refs are used) ══════════════════

#VAULT_ADDR=https://vault.internal:8200
#VAULT_NAMESPACE=admin
#VAULT_CACERT=/etc/ssl/certs/vault-ca.pem

## token | approle | kubernetes
RBAC_UI_VAULT_AUTH_METHOD=token
## token auth — prefer a 0600 token file over an inline token:
#RBAC_UI_VAULT_TOKEN_FILE=/etc/rbac-ui/vault-token
#VAULT_TOKEN=hvs.EXAMPLEonlyNeverCommitARealToken
## approle auth:
#RBAC_UI_VAULT_ROLE_ID=12345678-aaaa-bbbb-cccc-1234567890ab
#RBAC_UI_VAULT_SECRET_ID_FILE=/etc/rbac-ui/vault-secret-id
## kubernetes auth (when RBACGrant itself runs in a cluster):
#RBAC_UI_VAULT_K8S_ROLE=rbacgrant

## KV mount + base path for the app's own secrets.
RBAC_UI_VAULT_KV_MOUNT=secret
RBAC_UI_VAULT_PATH_PREFIX=k8s-rbac-builder


## ════ 6 · ISSUED CREDENTIALS (Kubeconfig & Grant Access pages) ═════════════

## ServiceAccount tokens: picker default + hard cap (bounds the calendar).
RBAC_UI_DEFAULT_TOKEN_TTL=8h
RBAC_UI_MAX_TOKEN_TTL=7d

## User client certificates: picker default + hard cap (bounds the calendar).
RBAC_UI_DEFAULT_CERT_TTL=24h
RBAC_UI_MAX_CERT_TTL=7d

## Legacy never-expiring Secret-based SA tokens — keep off.
RBAC_UI_ALLOW_LEGACY_SA_TOKENS=false


## ════ 7 · CLUSTER CONNECTION SAFETY ════════════════════════════════════════

## Optional allowlist of API server URLs that may be registered.
#RBAC_UI_ALLOWED_API_SERVERS=https://k8s-prod.example.com:6443,https://k8s-staging.example.com:6443

## Accept kubeconfigs with insecure-skip-tls-verify (warning badge if used).
RBAC_UI_ALLOW_INSECURE_CLUSTER_TLS=false

## Whether a kubeconfig may name an API server that resolves to loopback
## (127.0.0.0/8, ::1). Part of the SSRF guard in kubeconfig_validation.py.
##   false → such a kubeconfig is refused at upload with "the API server
##           resolves to loopback". Keeps someone who can upload a kubeconfig
##           from making THIS server call services only it can reach — its own
##           port, a sidecar, anything bound to its localhost.
##   true  → loopback is accepted. Metadata IPs (169.254.169.254) and other
##           link-local addresses stay blocked either way; this flag does not
##           widen those.
## Set it true only when the API server really is on the loopback of the host
## running RBACGrant — k3d, kind, OrbStack, Docker Desktop on your own machine.
## In a container or a pod, 127.0.0.1 is that container's own namespace, not
## your host, so enabling it there gains nothing: point the kubeconfig at an
## address the container can reach instead (in-cluster: kubernetes.default.svc).
RBAC_UI_ALLOW_LOOPBACK_API_SERVERS=false

## Exec credential plugins a kubeconfig may invoke (empty = none allowed).
#RBAC_UI_ALLOWED_EXEC_PLUGINS=aws,gke-gcloud-auth-plugin,kubelogin

## Timeout for every Kubernetes API call (discovery, apply, can-i, …).
RBAC_UI_K8S_TIMEOUT=15s


## ════ 8 · GUARDRAILS & MISC ════════════════════════════════════════════════

## Custom guardrail policy (hard blocks / override-with-reason) used on apply.
#RBAC_UI_POLICY_FILE=./profiles/policy.yaml

## Directory of saved builder profiles/templates.
RBAC_UI_PROFILES_DIR=./profiles
