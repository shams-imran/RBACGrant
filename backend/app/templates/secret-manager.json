{
  "title": "Secret manager",
  "description": "Full control of Secrets in one namespace \u2014 for the few people or controllers that genuinely own them. Secrets access is high-risk by nature; the badge is the point.",
  "variables": [
    "team",
    "namespace"
  ],
  "bundle": {
    "roles": [
      {
        "kind": "Role",
        "metadata": {
          "name": "${team}-secret-manager",
          "namespace": "${namespace}",
          "annotations": {
            "rbac-builder/owner": "${team}",
            "rbac-builder/description": "secret management in ${namespace} for ${team}"
          }
        },
        "rules": [
          {
            "apiGroups": [
              ""
            ],
            "resources": [
              "secrets"
            ],
            "verbs": [
              "get",
              "list",
              "watch",
              "create",
              "update",
              "patch",
              "delete"
            ]
          }
        ]
      }
    ],
    "bindings": [
      {
        "kind": "RoleBinding",
        "name": "${team}-secret-managers",
        "namespaces": [
          "${namespace}"
        ],
        "annotations": {
          "rbac-builder/owner": "${team}",
          "rbac-builder/description": "secret management in ${namespace} for ${team}"
        },
        "roleRef": {
          "kind": "Role",
          "name": "${team}-secret-manager"
        },
        "subjects": [
          {
            "kind": "Group",
            "name": "${team}-secret-admins"
          }
        ]
      }
    ],
    "serviceAccounts": []
  }
}
