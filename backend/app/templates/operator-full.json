{
  "title": "Operator bootstrap — full",
  "description": "Full operator identity. WARNING: bind + escalate + serviceaccounts/token is equivalent to cluster-admin; the gains are a separate, auditable, revocable identity with short-lived tokens.",
  "variables": [],
  "bundle": {
    "serviceAccounts": [{"name": "rbac-builder-operator", "namespace": "rbac-builder", "automountServiceAccountToken": false}],
    "roles": [{
      "kind": "ClusterRole",
      "metadata": {"name": "rbac-builder-operator"},
      "rules": [
        {"apiGroups": ["rbac.authorization.k8s.io"], "resources": ["roles", "clusterroles", "rolebindings", "clusterrolebindings"], "verbs": ["get", "list", "watch", "create", "update", "patch", "delete"]},
        {"apiGroups": ["rbac.authorization.k8s.io"], "resources": ["roles", "clusterroles"], "verbs": ["bind", "escalate"]},
        {"apiGroups": [""], "resources": ["namespaces"], "verbs": ["get", "list", "watch"]},
        {"apiGroups": [""], "resources": ["serviceaccounts"], "verbs": ["get", "list", "watch", "create", "delete"]},
        {"apiGroups": ["apiextensions.k8s.io"], "resources": ["customresourcedefinitions"], "verbs": ["get", "list", "watch"]},
        {"apiGroups": [""], "resources": ["serviceaccounts/token"], "verbs": ["create"]},
        {"apiGroups": ["certificates.k8s.io"], "resources": ["certificatesigningrequests"], "verbs": ["create", "get", "list", "delete"]},
        {"apiGroups": ["certificates.k8s.io"], "resources": ["certificatesigningrequests/approval"], "verbs": ["update"]},
        {"apiGroups": ["certificates.k8s.io"], "resources": ["signers"], "resourceNames": ["kubernetes.io/kube-apiserver-client"], "verbs": ["approve"]},
        {"apiGroups": ["authorization.k8s.io"], "resources": ["subjectaccessreviews"], "verbs": ["create"]}
      ]
    }],
    "bindings": [{
      "kind": "ClusterRoleBinding", "name": "rbac-builder-operator-binding", "namespaces": [],
      "roleRef": {"kind": "ClusterRole", "name": "rbac-builder-operator"},
      "subjects": [{"kind": "ServiceAccount", "name": "rbac-builder-operator", "namespace": "rbac-builder"}]
    }]
  }
}
